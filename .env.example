# Sailly website — copy to .env.local and fill in values.
# See NextSteps.md §7 and SUPABASE_SETUP.md.

# ── Auth mode ──────────────────────────────────────────────
# Set both for local mock auth (no real Supabase required):
# AUTH_MODE=mock
# NEXT_PUBLIC_AUTH_MODE=mock

AUTH_MODE=
NEXT_PUBLIC_AUTH_MODE=

# ── Supabase (required for real auth) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Voice-agent backend ────────────────────────────────────
VOICE_AGENT_ORIGIN=http://127.0.0.1:8080
NEXT_PUBLIC_VOICE_AGENT_ORIGIN=

# ── Demo / contact ─────────────────────────────────────────
DEMO_API_PROXY=
DEMO_LIVE_CALLS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CONTACT_WEBHOOK_URL=

# ── Stripe (M1) ────────────────────────────────────────────
# When AUTH_MODE=mock, checkout uses an in-memory mock path (no keys needed).
# For live Stripe: set secret + publishable + webhook secret + Price IDs.
# Overage (€0.12/min) remains manual invoice for v1 — not metered in Stripe yet.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTERS=
STRIPE_PRICE_MAIN=
STRIPE_PRICE_PRESIDENT_SUITE=
# Optional: 30-day 50% intro coupon applied at Checkout
STRIPE_TRIAL_COUPON_ID=

# ── Optional ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BASE_URL=http://localhost:3000
