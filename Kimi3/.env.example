# Copy to .env and fill in. NEVER commit the real .env.
# Moonshot (Kimi) API key — https://platform.moonshot.ai/console/api-keys
MOONSHOT_KEY=sk-your-moonshot-key-here

# Model forced by the proxy (Cursor's model name is ignored)
TARGET_MODEL=kimi-k3

# Moonshot API host (default is fine)
MOONSHOT_HOST=api.moonshot.ai

# Local proxy port (default 8787)
# PORT=8787
